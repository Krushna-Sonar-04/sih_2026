# DRISHTI backend environment template.
# Copy to .env and fill in real values locally. NEVER commit real secrets.
# Every credential below is read server-side only and is never sent to the frontend.

# --- Database -----------------------------------------------------------
# PostgreSQL (recommended):
DATABASE_URL=postgresql+psycopg://drishti:drishti_local_dev@localhost:5432/drishti
# Local fallback without PostgreSQL:
# DATABASE_URL=sqlite:///./drishti.db

# --- API ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SEED_DEMO_DATA=true
MIN_COHORT_PERCENTAGE=5.0

# --- Telegram connector (optional; absent = "Not configured") -----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional webhook deployment (polling is the local default)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLL_SECONDS=60
# Optional MTProto/Telethon historical path (kept separate from the Bot API path)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- X connector (optional; absent = "Not configured") ------------------
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Ingestion / scheduler ----------------------------------------------
# INGESTION_ENABLED=true plus a non-manual interval starts one background worker.
INGESTION_ENABLED=false
SCHEDULER_INTERVAL=manual   # manual | 5m | 15m | hourly
ADAPTER_MAX_RETRIES=2
# Only when explicitly true may connector tests perform real network calls in tests.
LIVE_CONNECTOR_TEST=false

# --- Analyst assistant LLM (optional; absent = deterministic responses) --
LLM_PROVIDER=auto
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
